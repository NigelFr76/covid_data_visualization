# Copy to .env and adjust if needed. Do not commit real secrets.

POSTGRES_USER=covid_user
POSTGRES_PASSWORD=covid_password
POSTGRES_DB=covid_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# JDBC (Spark) vs libpq (psycopg2)
DB_URL=postgresql://covid_user:covid_password@localhost:5432/covid_db
JDBC_URL=jdbc:postgresql://localhost:5432/covid_db
DB_USER=covid_user
DB_PASSWORD=covid_password

GRAFANA_READER_USER=grafana_reader
GRAFANA_READER_PASSWORD=grafana_reader_pass
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

KAFKA_BROKER=localhost:29092
KAFKA_TOPIC=covid-raw-records

TREND_THRESHOLD_PCT=10
TREND_MIN_OBS=7

# Replay defaults
REPLAY_SPEED=0.05
REPLAY_LIMIT=500
